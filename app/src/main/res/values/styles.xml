<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Base_BizBundle_Theme" parent="AppTheme">
        <item name="status_font_color">@color/status_font_color</item>
        <item name="status_bg_color">@color/status_bg_color</item>
        <item name="navbar_font_color">@color/navbar_font_color</item>
        <item name="navbar_bg_color">@color/navbar_bg_color</item>
        <item name="app_bg_color">@color/app_bg_color</item>
        <item name="fragment_bg_color">@color/app_bg_color</item>
        <item name="list_primary_color">@color/list_primary_color</item>
        <item name="list_sub_color">@color/list_sub_color</item>
        <item name="list_secondary_color">@color/list_secondary_color</item>
        <item name="list_line_color">@color/list_line_color</item>
        <item name="list_bg_color">@color/list_bg_color</item>
        <item name="primary_button_font_color">@color/primary_button_font_color</item>
        <item name="primary_button_bg_color">@color/primary_button_bg_color</item>
        <item name="secondary_button_font_color">@color/secondary_button_font_color</item>
        <item name="secondary_button_bg_color">@color/secondary_button_bg_color</item>
        <item name="notice_font_color">@color/notice_font_color</item>
        <item name="notice_bg_color">@color/notice_bg_color</item>
        <item name="bg_normal_text_bt">@drawable/bg_text_bts</item>
        <item name="app_name">@string/app_name</item>
        <item name="is_splash_used">false</item>
        <item name="ap_default_ssid">@string/ap_mode_ssid</item>
        <item name="ap_connect_description">@string/ty_ap_connect_description</item>
        <item name="is_scan_support">@bool/is_scan_support</item>
        <item name="is_need_blemesh_support">@bool/is_need_blemesh_support</item>
        <item name="status_bg_color_75">@color/status_bg_color_75</item>
        <item name="status_bg_color_90">@color/status_bg_color_90</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_deep_blue</item>
        <item name="colorPrimaryDark">@color/primary_deep_blue</item>
        <item name="colorAccent">@color/accent_neon_green</item>
        <item name="android:colorBackground">@color/background_gradient_start</item>
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:statusBarColor">@color/primary_deep_blue</item>
        <item name="android:navigationBarColor">@color/primary_deep_blue</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
    </style>

    <style name="TextAppearance.App.TitleSmall" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="android:textSize">@dimen/text_title_small</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
    </style>

    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_disabled</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
    </style>

    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0.0125</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_inverse</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/padding_large</item>
        <item name="android:paddingEnd">@dimen/padding_large</item>
        <item name="backgroundTint">@color/button_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:elevation">@dimen/elevation_medium</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/button_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/padding_large</item>
        <item name="android:paddingEnd">@dimen/padding_large</item>
        <item name="strokeColor">@color/button_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:padding">@dimen/padding_small</item>
        <item name="backgroundTint">@color/glass_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:elevation">@dimen/elevation_small</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <style name="Widget.App.Card.Glassmorphic" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/glass_primary</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">@dimen/elevation_medium</item>
        <item name="contentPadding">@dimen/padding_large</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.App.Card.Device" parent="Widget.App.Card.Glassmorphic">
        <item name="android:minHeight">@dimen/device_card_height</item>
        <item name="android:minWidth">@dimen/device_card_width</item>
        <item name="contentPadding">@dimen/padding_medium</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/button_primary</item>
        <item name="hintTextColor">@color/button_primary</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <style name="Widget.App.TextInput" parent="Widget.MaterialComponents.TextInputEditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:background">@color/glass_secondary</item>
    </style>

    <style name="Widget.App.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/glass_primary</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="android:elevation">@dimen/elevation_large</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/glass_primary</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="android:elevation">@dimen/elevation_medium</item>
    </style>

    <style name="Widget.App.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/button_primary</item>
        <item name="tint">@color/text_inverse</item>
        <item name="android:elevation">@dimen/elevation_large</item>
        <item name="rippleColor">@color/ripple_color</item>
    </style>

    <style name="Widget.App.ProgressBar" parent="Widget.MaterialComponents.CircularProgressIndicator">
        <item name="indicatorColor">@color/button_primary</item>
        <item name="trackColor">@color/glass_secondary</item>
    </style>

    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="Widget.App.StatusIndicator.Online">
        <item name="android:background">@drawable/status_indicator_online</item>
        <item name="android:minWidth">8dp</item>
        <item name="android:minHeight">8dp</item>
    </style>

    <style name="Widget.App.StatusIndicator.Offline">
        <item name="android:background">@drawable/status_indicator_offline</item>
        <item name="android:minWidth">8dp</item>
        <item name="android:minHeight">8dp</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/glass_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/glass_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <style name="Widget.App.Divider">
        <item name="android:background">@color/glass_secondary</item>
        <item name="android:layout_height">1dp</item>
    </style>

    <!-- Missing styles that the build is looking for -->
    <style name="Widget.App" parent="Widget.MaterialComponents.Button">
        <!-- Base app widget style -->
    </style>

    <style name="Widget.App.StatusIndicator" parent="Widget.App">
        <item name="android:minWidth">8dp</item>
        <item name="android:minHeight">8dp</item>
    </style>

    <style name="Widget.MaterialComponents.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/inter_variablefont_opsz_wght</item>
    </style>

    <style name="ShapeAppearance.App.Circle" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>