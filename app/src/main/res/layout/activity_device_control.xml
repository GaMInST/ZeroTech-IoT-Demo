<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".DeviceControlActivity">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@drawable/glassmorphic_card_bg"
            app:layout_scrollFlags="scroll|enterAlways|snap"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Device Control"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Device Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/device_status_card"
                style="@style/Widget.App.Card.Glassmorphic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/device_status_indicator"
                            style="@style/Widget.App.StatusIndicator.Online"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="@dimen/spacing_12" />

                        <TextView
                            android:id="@+id/device_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_bold"
                            android:text="Living Room Light"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_title" />

                        <ImageView
                            android:id="@+id/device_icon"
                            android:layout_width="@dimen/icon_xlarge"
                            android:layout_height="@dimen/icon_xlarge"
                            android:contentDescription="Device Icon"
                            android:src="@drawable/ic_light_bulb"
                            android:tint="@color/button_primary" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/device_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:fontFamily="@font/inter_regular"
                        android:text="On • 80% brightness • Living Room"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Primary Control Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/primary_control_card"
                style="@style/Widget.App.Card.Glassmorphic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Power"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title_small" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/power_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:checked="true"
                        app:thumbTint="@color/button_primary"
                        app:trackTint="@color/glass_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Brightness Control Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/brightness_control_card"
                style="@style/Widget.App.Card.Glassmorphic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Brightness"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_title_small" />

                        <TextView
                            android:id="@+id/brightness_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="80%"
                            android:textColor="@color/button_primary"
                            android:textSize="@dimen/text_title_small" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/brightness_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:value="80"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:stepSize="1"
                        app:thumbColor="@color/button_primary"
                        app:trackColorActive="@color/button_primary"
                        app:trackColorInactive="@color/glass_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Color Temperature Control Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/color_temp_control_card"
                style="@style/Widget.App.Card.Glassmorphic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Color Temperature"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_title_small" />

                        <TextView
                            android:id="@+id/color_temp_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="2700K"
                            android:textColor="@color/button_primary"
                            android:textSize="@dimen/text_title_small" />

                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/color_temp_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:value="2700"
                        android:valueFrom="2200"
                        android:valueTo="6500"
                        android:stepSize="100"
                        app:thumbColor="@color/button_primary"
                        app:trackColorActive="@color/button_primary"
                        app:trackColorInactive="@color/glass_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:gravity="center_horizontal"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Warm"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Cool"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Actions Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_actions_card"
                style="@style/Widget.App.Card.Glassmorphic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Quick Actions"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title_small" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/action_reading"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/spacing_4"
                            android:text="Reading"
                            android:textSize="@dimen/text_body_small" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/action_relax"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/spacing_4"
                            android:text="Relax"
                            android:textSize="@dimen/text_body_small" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/action_focus"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/spacing_4"
                            android:text="Focus"
                            android:textSize="@dimen/text_body_small" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/action_night"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/button_height"
                            android:layout_columnWeight="1"
                            android:layout_margin="@dimen/spacing_4"
                            android:text="Night"
                            android:textSize="@dimen/text_body_small" />

                    </GridLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Schedule Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/schedule_card"
                style="@style/Widget.App.Card.Glassmorphic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_large">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:fontFamily="@font/inter_semibold"
                        android:text="Schedule"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title_small" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/add_schedule_button"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="Add Schedule"
                        android:textSize="@dimen/text_body_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 