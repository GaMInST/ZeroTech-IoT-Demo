<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".MainActivity">

    <!-- App Bar with Glassmorphism Effect -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@drawable/glassmorphic_card_bg"
            app:layout_scrollFlags="scroll|enterAlways|snap"
            app:title=""
            app:titleTextColor="@color/text_primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium">

                <TextView
                    android:id="@+id/current_family_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableEnd="@drawable/ic_arrow_drop_down_black_24dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="ZeroTech Smart Home"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/theme_switch"
                    style="@style/Widget.App.Button.Icon"
                    android:layout_width="@dimen/touch_target_medium"
                    android:layout_height="@dimen/touch_target_medium"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:text="🌙"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logout"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:text="Logout"
                    android:textSize="@dimen/text_body_small" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Hero Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hero_section"
                style="@style/Widget.App.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_section_height"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="320dp"
                    android:layout_height="240dp"
                    android:orientation="vertical"
                    android:padding="@dimen/hero_content_padding">

                    <TextView
                        android:layout_width="268dp"
                        android:layout_height="118dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="2"
                        android:text="Welcome Home"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_headline" />

                    <TextView
                        android:id="@+id/welcome_stats_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:maxLines="2"
                        android:text="12 devices online • 3 rooms active"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                    <!-- Quick Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_24"
                        android:orientation="horizontal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quick_all_on"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="@dimen/spacing_8"
                        android:layout_weight="1"
                        android:text="All On"
                        android:textSize="@dimen/text_body_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Rooms Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:fontFamily="@font/inter_semibold"
                android:text="Rooms"
                android:textColor="@color/text_headline"
                android:textSize="@dimen/text_title" />

            <!-- Recent Devices Section -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rooms_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_32"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_room_card" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:fontFamily="@font/inter_semibold"
                android:text="Recent Devices"
                android:textColor="@color/text_headline"
                android:textSize="@dimen/text_title" />

            <!-- Quick Access Buttons -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/devices_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_32"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/spacing_8"
                android:paddingEnd="@dimen/spacing_8"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                tools:itemCount="4"
                tools:listitem="@layout/item_device_card" />

            <!-- Smart Home Features Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:fontFamily="@font/inter_semibold"
                android:text="Smart Home Features"
                android:textColor="@color/text_headline"
                android:textSize="@dimen/text_title" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_32"
                android:columnCount="2"
                android:rowCount="3">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/panel"
                    style="@style/Widget.App.Card.Interactive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:src="@drawable/ic_device_control"
                            android:contentDescription="Device Control"
                            android:tint="@color/button_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Device Control"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/scene"
                    style="@style/Widget.App.Card.Interactive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:src="@drawable/ic_smart_scene"
                            android:contentDescription="Smart Scenes"
                            android:tint="@color/iot_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Smart Scenes"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/activator"
                    style="@style/Widget.App.Card.Interactive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:src="@drawable/ic_add_device"
                            android:contentDescription="Add Device"
                            android:tint="@color/accent_neon_green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Add Device"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/control"
                    style="@style/Widget.App.Card.Interactive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:src="@drawable/ic_multi_control"
                            android:contentDescription="Multi Control"
                            android:tint="@color/primary_deep_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Multi Control"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ipc"
                    style="@style/Widget.App.Card.Interactive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:src="@drawable/ic_camera"
                            android:contentDescription="Cameras"
                            android:tint="@color/button_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Cameras"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mall"
                    style="@style/Widget.App.Card.Interactive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:src="@drawable/ic_store_placeholder"
                            android:contentDescription="Device Store"
                            android:tint="@color/iot_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Device Store"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/Widget.App.BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Floating Action Button - Positioned center-right above navigation bar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_device"
        style="@style/Widget.App.FloatingActionButton"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="@dimen/bottom_nav_height"
        android:layout_marginEnd="@dimen/spacing_16"
        android:contentDescription="Add Device"
        android:src="@drawable/ic_quick_action"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
