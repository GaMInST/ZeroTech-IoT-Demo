<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/thing_theme_open_color_background"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/toolbar_main"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/current_family_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:drawableRight="@drawable/ic_arrow_drop_down_black_24dp"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Home"
            android:textColor="@color/thing_theme_open_color_head_line_text"
            android:textSize="24dp" />

        <TextView
            android:id="@+id/logout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:gravity="center"
            android:paddingRight="16dp"
            android:text="Logout"
            android:textColor="@color/thing_theme_open_color_head_line_text"
            android:textSize="16sp" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_main">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/theme_switch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Switch Theme"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/panel"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Device Control"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/mall"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Device Store"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/scene"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Smart Scenes"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/ipc"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Camera Control"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/cloud_storage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Cloud Storage"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/activator"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Device Pairing"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Message Center"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/feedback"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Help &amp; Feedback"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/ota"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Firmware Update"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/family"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Home Management"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/device_detail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Device Details"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/control"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Multi Control"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Location Services"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/groupmanager"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Device Groups"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/alexa_google_bind"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Voice Assistant"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/light_scene"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Light Scenes"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/share"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Share Devices"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/miniapp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Mini Apps"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/third_service"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Advanced Features"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

            <TextView
                android:id="@+id/market_push"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="50dp"
                android:gravity="center"
                android:text="Marketing"
                android:textColor="@color/thing_theme_open_color_head_line_text" />

        </LinearLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>