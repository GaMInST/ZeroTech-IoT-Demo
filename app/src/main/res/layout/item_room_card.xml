<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card.Glassmorphic"
    android:layout_width="match_parent"
    android:layout_height="@dimen/card_height_medium"
    android:layout_margin="@dimen/spacing_4"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_medium"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <ImageView
            android:id="@+id/room_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="@dimen/spacing_8"
            android:contentDescription="Room Icon"
            android:src="@drawable/ic_device_default"
            android:tint="@color/button_primary" />

        <TextView
            android:id="@+id/room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="Living Room"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Living Room" />

        <TextView
            android:id="@+id/room_device_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="4 devices"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="4 devices" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 