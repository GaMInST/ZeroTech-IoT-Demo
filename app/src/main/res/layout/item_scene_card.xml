<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scene_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_8"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/iot_surface"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_small"
    app:strokeColor="@color/glass_secondary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_large">

        <!-- Scene Icon -->
        <ImageView
            android:id="@+id/scene_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/spacing_16"
            android:background="@drawable/bg_icon_circle"
            android:padding="12dp"
            android:src="@drawable/ic_scene"
            app:tint="@color/button_primary" />

        <!-- Scene Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scene_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="Good Morning"
                android:textColor="@color/iot_text"
                android:textSize="@dimen/text_title_small"
                tools:text="Good Morning" />

            <TextView
                android:id="@+id/scene_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:fontFamily="@font/inter_regular"
                android:text="Turn on lights and start coffee maker"
                android:textColor="@color/iot_text_secondary"
                android:textSize="@dimen/text_body_small"
                tools:text="Turn on lights and start coffee maker" />

            <TextView
                android:id="@+id/scene_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:fontFamily="@font/inter_regular"
                android:text="1 condition • 3 actions"
                android:textColor="@color/text_disabled"
                android:textSize="@dimen/text_caption"
                tools:text="1 condition • 3 actions" />

        </LinearLayout>

        <!-- Scene Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/spacing_12"
            android:orientation="vertical">

            <!-- Scene Toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/scene_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:checked="true"
                app:thumbTint="@color/button_primary"
                app:trackTint="@color/glass_secondary" />

            <!-- Execute Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/execute_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/spacing_8"
                android:enabled="true"
                android:src="@drawable/ic_play"
                app:backgroundTint="@color/button_primary"
                app:cornerRadius="18dp"
                app:iconSize="16dp"
                app:tint="@color/white" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 