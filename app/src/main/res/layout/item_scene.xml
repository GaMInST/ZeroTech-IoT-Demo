<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sceneCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Scene Icon -->
        <ImageView
            android:id="@+id/sceneIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Scene Icon"
            android:src="@drawable/ic_relax"
            android:tint="?attr/colorPrimary" />

        <!-- Scene Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Scene Name -->
            <TextView
                android:id="@+id/sceneName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scene Name"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Scene Description -->
            <TextView
                android:id="@+id/sceneDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Scene description"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Scene Type and Status Chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <!-- Scene Type Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/sceneType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Manual"
                android:textSize="12sp"
                app:chipBackgroundColor="@android:color/holo_blue_light"
                app:chipMinHeight="24dp" />

            <!-- Scene Status Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/sceneStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textSize="12sp"
                app:chipBackgroundColor="@android:color/holo_green_light"
                app:chipMinHeight="24dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 