<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/device_card"
    style="@style/Widget.App.Card.Device"
    android:layout_width="match_parent"
    android:layout_height="@dimen/device_card_height"
    android:layout_margin="@dimen/device_card_spacing"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_medium"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium"
        android:gravity="center">

        <!-- Device Icon -->
        <ImageView
            android:id="@+id/device_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="@dimen/spacing_8"
            android:contentDescription="Device Icon"
            android:src="@drawable/ic_device_default"
            android:tint="@color/button_primary" />

        <!-- Device Name -->
        <TextView
            android:id="@+id/device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_4"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="2"
            android:text="Smart Light"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body_small"
            android:gravity="center"
            android:textAlignment="center"
            tools:text="Smart Light" />

        <!-- Device Status -->
        <TextView
            android:id="@+id/device_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_4"
            android:fontFamily="@font/inter_regular"
            android:text="Online • On"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            tools:text="Online • On" />

        <!-- Status Indicator -->
        <View
            android:id="@+id/status_indicator"
            style="@style/Widget.App.StatusIndicator.Online"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginBottom="@dimen/spacing_4" />

        <!-- Room Name -->
        <TextView
            android:id="@+id/room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="Living Room"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            tools:text="Living Room" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 