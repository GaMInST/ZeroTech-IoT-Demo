<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card.Device"
    android:layout_width="match_parent"
    android:layout_height="@dimen/device_card_height"
    android:layout_margin="@dimen/device_card_spacing"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_large"
    app:cardElevation="@dimen/elevation_medium"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/padding_medium">

        <!-- Header with Status Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/status_indicator"
                style="@style/Widget.App.StatusIndicator.Online"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="@dimen/spacing_8" />

            <TextView
                android:id="@+id/device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_semibold"
                android:maxLines="1"
                android:text="Smart Light"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_small"
                tools:text="Smart Light" />

            <ImageView
                android:id="@+id/device_icon"
                android:layout_width="@dimen/icon_medium"
                android:layout_height="@dimen/icon_medium"
                android:layout_marginStart="@dimen/spacing_8"
                android:contentDescription="Device Icon"
                android:src="@drawable/ic_device_default"
                android:tint="@color/button_primary" />

        </LinearLayout>

        <!-- Device Status -->
        <TextView
            android:id="@+id/device_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:fontFamily="@font/inter_regular"
            android:text="On • 80% brightness"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            tools:text="On • 80% brightness" />

        <!-- Quick Control Toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/device_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_12"
            android:checked="true"
            app:thumbTint="@color/button_primary"
            app:trackTint="@color/glass_secondary" />

        <!-- Room Name -->
        <TextView
            android:id="@+id/room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_8"
            android:fontFamily="@font/inter_regular"
            android:text="Living Room"
            android:textColor="@color/text_disabled"
            android:textSize="@dimen/text_caption"
            tools:text="Living Room" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 