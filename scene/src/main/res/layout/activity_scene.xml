<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".SceneActivity">

    <!-- App Bar with Glassmorphism Effect -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_main"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@drawable/glassmorphic_card_bg"
            app:layout_scrollFlags="scroll|enterAlways|snap"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Smart Scenes"
            app:titleTextAppearance="@style/TextAppearance.App.TitleMedium"
            app:titleTextColor="@color/text_primary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Hero Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/hero_content_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="Create Smart Scenes"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:fontFamily="@font/inter_regular"
                        android:text="Set up automated actions with if-then conditions to control your smart home devices intelligently."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                    <!-- Scene Stats -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="12"
                                android:textColor="@color/button_primary"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_regular"
                                android:text="Active Scenes"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/glass_border" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/padding_small">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="8"
                                android:textColor="@color/iot_secondary"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_regular"
                                android:text="Automated"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Actions Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                android:fontFamily="@font/inter_semibold"
                android:text="Quick Actions"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_32"
                android:columnCount="2"
                android:rowCount="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/add_scene_card"
                    style="@style/Widget.App.Card.Glassmorphic"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:background="@drawable/ic_add_circle"
                            android:contentDescription="Add Scene"
                            android:src="@drawable/ic_add" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Add Scene"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Create new"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/edit_scene_card"
                    style="@style/Widget.App.Card.Glassmorphic"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:background="@drawable/ic_edit_circle"
                            android:contentDescription="Edit Scene"
                            android:src="@drawable/ic_edit" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Edit Scene"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Modify existing"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/set_location_card"
                    style="@style/Widget.App.Card.Glassmorphic"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:background="@drawable/ic_location_circle"
                            android:contentDescription="Set Location"
                            android:src="@drawable/ic_location_on" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Set Location"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="GPS coordinates"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/set_map_card"
                    style="@style/Widget.App.Card.Glassmorphic"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/card_height_medium"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/spacing_4"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/background_card_enhanced">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_medium">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginBottom="@dimen/spacing_8"
                            android:background="@drawable/ic_map_circle"
                            android:contentDescription="Map Settings"
                            android:src="@drawable/ic_map" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Map Settings"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Location conditions"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:maxLines="1"
                            android:ellipsize="end" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Information Section -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_12"
                        android:fontFamily="@font/inter_semibold"
                        android:text="About Smart Scenes"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title_small" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Smart Scenes allow you to create automated actions based on conditions. For example, turn on lights when you arrive home, or set the thermostat when you leave. You can set up location-based triggers, time schedules, and device state conditions."
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button - Positioned above navigation bar with proper spacing -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_create_scene"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_24"
        android:text="Create Scene"
        app:icon="@drawable/ic_add"
        app:backgroundTint="@color/button_primary"
        app:iconTint="@color/text_inverse"
        app:tint="@color/text_inverse"
        app:fabSize="normal" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>