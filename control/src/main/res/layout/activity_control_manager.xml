<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ControlManagerActivity">

    <!-- Device Statistics Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Statistics"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDeviceCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Count: 0"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvOnlineCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online Devices: 0"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Control Options -->
    <Button
        android:id="@+id/btnIndividualControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Individual Device Control"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_primary"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnGoMultiControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Multi-Control Linkage"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_secondary"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnDeviceManagement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device Management"
        android:layout_marginBottom="12dp"
        android:background="@drawable/button_secondary"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh Device Status"
        android:background="@drawable/button_outline"
        android:textColor="@android:color/black" />

</LinearLayout>